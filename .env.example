# ============================================================
# Project Rain Man — Environment Variables
# Copy this to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/rainman"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_REFRESH_SECRET="replace-with-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Encryption (for storing Bybit API keys) ---
ENCRYPTION_KEY="replace-with-32-byte-hex-string"

# --- Bybit (per-user keys stored in DB — these are fallback/admin only) ---
BYBIT_TESTNET=true

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Client ---
VITE_API_URL=http://localhost:3001
